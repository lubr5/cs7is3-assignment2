Federal Register
<!-- PJG /ITAG -->

<!-- PJG ITAG l=90 g=1 f=1 -->
&blank;/&blank;Vol. 59. No. 250&blank;/&blank;Friday, December 30, 1994&blank;/&blank;Rules and Regulations

<!-- PJG 0012 frnewline -->

<!-- PJG 0012 frnewline -->

<!-- PJG /ITAG -->

<!-- PJG ITAG l=52 g=1 f=1 -->

<USDEPT>OFFICE OF PERSONNEL MANAGEMENT </USDEPT>

<!-- PJG 0012 frnewline -->

<!-- PJG 0012 frnewline -->

<USDEPT>5 CFR Part 315 </USDEPT>

<!-- PJG 0012 frnewline -->

<!-- PJG 0012 frnewline -->

