<TEXT>
 
<!-- PJG STAG 4700 -->

<!-- PJG ITAG l=84 g=1 f=1 -->
E.O. 12866, Regulatory Review
<!-- PJG 0012 frnewline -->

<!-- PJG 0012 frnewline -->

<!-- PJG /ITAG -->

<!-- PJG ITAG l=11 g=1 f=1 -->

