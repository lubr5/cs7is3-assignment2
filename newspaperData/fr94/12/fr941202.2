<!-- PJG ITAG l=10 g=1 f=2 -->
ACTION:
<!-- PJG /ITAG -->

<!-- PJG ITAG l=10 g=1 f=1 -->
 Notice.
<!-- PJG /ITAG -->

<!-- PJG ITAG l=59 g=1 f=1 -->

<!-- PJG 0012 frnewline -->

<!-- PJG /ITAG -->
</ACTION>
<SUMMARY>
<!-- PJG ITAG l=10 g=1 f=2 -->
SUMMARY:
<!-- PJG /ITAG -->

<!-- PJG ITAG l=10 g=1 f=1 -->
 This notice publishes the first Conforming Products List (CPL) of devices that conform to the Model Specifications
for Screening Devices that measure alcohol in bodily fluids (59 FR 39382). 
<!-- PJG /ITAG -->

<!-- PJG QTAG 02 -->
<!-- PJG /QTAG -->

<!-- PJG 0012 frnewline -->
</SUMMARY>
<DATE>
<!-- PJG ITAG l=10 g=1 f=2 -->
