<!-- PJG /ITAG -->

<!-- PJG ITAG l=10 g=1 f=1 -->
 March 1, 1995. 
<!-- PJG /ITAG -->

<!-- PJG QTAG 02 -->
<!-- PJG /QTAG -->

<!-- PJG 0012 frnewline -->

<!-- PJG 0012 frnewline -->
</DATE>
<ADDRESS>
<!-- PJG ITAG l=10 g=1 f=2 -->
ADDRESSES:
<!-- PJG /ITAG -->

<!-- PJG ITAG l=10 g=1 f=1 -->
 Copies of the findings made by the Secretary in approving the Governor's recommendations may be obtained from the
Alaska Region, National Marine Fisheries Service, P.O. Box 21668, Juneau, AK 99802 (Attn: Lori Gravel). 
<!-- PJG /ITAG -->

<!-- PJG QTAG 02 -->
<!-- PJG /QTAG -->

<!-- PJG 0012 frnewline -->

<!-- PJG 0012 frnewline -->

<!-- PJG 0012 frnewline -->
