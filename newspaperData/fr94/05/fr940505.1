or freezing. 
<!-- PJG 0012 frnewline -->

<!-- PJG 0012 frnewline -->

<!-- PJG /ITAG -->

<!-- PJG ITAG l=11 g=1 f=3 -->
Grain mill production facility 
<!-- PJG /ITAG -->

<!-- PJG ITAG l=11 g=1 f=1 -->
