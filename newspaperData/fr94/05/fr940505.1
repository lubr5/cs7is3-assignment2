enclosed combustion device: 
<!-- PJG 0012 frnewline -->

<!-- PJG /ITAG -->

<!-- PJG ITAG l=11 g=1 f=3 -->
(1)
<!-- PJG /ITAG -->

<!-- PJG ITAG l=11 g=1 f=1 -->
 The average combustion temperature measured every 15 
