<!-- PJG 0012 frnewline -->

<!-- PJG 0012 frnewline -->

<!-- PJG /ITAG -->

<!-- PJG ITAG l=11 g=1 f=3 -->
Food preparation facility 
<!-- PJG /ITAG -->

<!-- PJG ITAG l=11 g=1 f=1 -->
means any commercial baking, commercial charbroiling, wine- or brandy-making, fruit and vegetable preservation,
grain mill production, vegetable oil production, or malt beverage production facility. This definition includes
restaurants involved in activities described in the previous sentence. 
<!-- PJG 0012 frnewline -->

<!-- PJG 0012 frnewline -->

<!-- PJG /ITAG -->

<!-- PJG ITAG l=11 g=1 f=3 -->
Fruit and vegetable preservation facility 
<!-- PJG /ITAG -->

<!-- PJG ITAG l=11 g=1 f=1 -->
