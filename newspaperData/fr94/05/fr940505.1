<TEXT>
 
<!-- PJG STAG 4702 -->

<!-- PJG 0012 frnewline -->

<!-- PJG 0012 frnewline -->

<!-- PJG ITAG l=11 g=1 f=1 -->

<!-- PJG /ITAG -->

<!-- PJG ITAG l=11 g=1 f=3 -->
Filler 
<!-- PJG /ITAG -->

<!-- PJG ITAG l=11 g=1 f=1 -->
means a preparation used to fill in cracks, grains, 
<!-- PJG 0012 frnewline -->
etc., of wood before applying a coating. 
<!-- PJG 0012 frnewline -->

<!-- PJG 0012 frnewline -->

<!-- PJG /ITAG -->

<!-- PJG ITAG l=11 g=1 f=3 -->
Flow coat 
<!-- PJG /ITAG -->

<!-- PJG ITAG l=11 g=1 f=1 -->
means to coat an object by flowing a stream of 
<!-- PJG 0012 frnewline -->
coating over an object and draining off any excess coating. 
<!-- PJG 0012 frnewline -->

<!-- PJG 0012 frnewline -->

<!-- PJG /ITAG -->

<!-- PJG ITAG l=11 g=1 f=3 -->
Grams of VOC per liter of material 
<!-- PJG /ITAG -->

<!-- PJG ITAG l=11 g=1 f=1 -->
means the weight of VOC per 
<!-- PJG 0012 frnewline -->
volume of material and can be calculated by the following equation: 
<!-- PJG 0012 frnewline -->

<!-- PJG 0012 frnewline -->

<!-- PJG /ITAG -->

<!-- PJG /STAG -->

<!-- PJG STAG 4725 -->

<IMPORT>

<!-- PJG importformat s,w220,d29 -->

<!-- PJG ITAG l=95 g=1 f=1 -->
E:GRAPHICSEP05my94.096
<!-- PJG /ITAG -->

</IMPORT>

<!-- PJG /STAG -->

<!-- PJG STAG 4702 -->

<!-- PJG 0012 frnewline -->

<!-- PJG 0012 frnewline -->

<!-- PJG ITAG l=16 g=1 f=1 -->
Where: 
<!-- PJG 0012 frnewline -->

<!-- PJG 0012 frnewline -->
Ws=weight of volatile compounds in grams 
<!-- PJG 0012 frnewline -->

<!-- PJG 0012 frnewline -->
Ww=weight of water in grams 
<!-- PJG 0012 frnewline -->

<!-- PJG 0012 frnewline -->
Wes=weight of exempt compounds in grams 
<!-- PJG 0012 frnewline -->

<!-- PJG 0012 frnewline -->
Vm= volume of material in liters 
<!-- PJG /ITAG -->

<!-- PJG QTAG 02 -->
<!-- PJG /QTAG -->

<!-- PJG 0012 frnewline -->

<!-- PJG 0012 frnewline -->

<!-- PJG ITAG l=11 g=1 f=1 -->

<!-- PJG /ITAG -->

<!-- PJG ITAG l=11 g=1 f=3 -->
High-solids stains 
<!-- PJG /ITAG -->

<!-- PJG ITAG l=11 g=1 f=1 -->
means stains containing more than 1 pound 
<!-- PJG 0012 frnewline -->
of solids per gallon, by weight, and can include wiping stains, 
<!-- PJG 0012 frnewline -->
glazes, and opaque stains. 
<!-- PJG 0012 frnewline -->

<!-- PJG 0012 frnewline -->

<!-- PJG /ITAG -->

<!-- PJG ITAG l=11 g=1 f=3 -->
High-volume, low-pressure (HVLP) spray 
<!-- PJG /ITAG -->

<!-- PJG ITAG l=11 g=1 f=1 -->
means to spray a 
<!-- PJG 0012 frnewline -->
coating by means of a gun that operates between 0.1 and 10.0 pounds 
<!-- PJG 0012 frnewline -->
per square inch gauge (psig) air pressure. 
<!-- PJG 0012 frnewline -->

<!-- PJG 0012 frnewline -->

<!-- PJG /ITAG -->

<!-- PJG ITAG l=11 g=1 f=3 -->
Ink 
<!-- PJG /ITAG -->

<!-- PJG ITAG l=11 g=1 f=1 -->
means a fluid that contains dyes and/or colorants and is 
<!-- PJG 0012 frnewline -->
used to make markings, but not to protect surfaces. 
<!-- PJG 0012 frnewline -->

<!-- PJG 0012 frnewline -->

<!-- PJG /ITAG -->

<!-- PJG ITAG l=11 g=1 f=3 -->
Low-solids stains 
<!-- PJG /ITAG -->

<!-- PJG ITAG l=11 g=1 f=1 -->
means stains containing 1 pound of solids 
<!-- PJG 0012 frnewline -->
per gallon, or less, by weight. 
<!-- PJG 0012 frnewline -->

<!-- PJG 0012 frnewline -->

<!-- PJG /ITAG -->

<!-- PJG ITAG l=11 g=1 f=3 -->
Mold-seal coating 
<!-- PJG /ITAG -->

<!-- PJG ITAG l=11 g=1 f=1 -->
means the initial coating applied to a new 
<!-- PJG 0012 frnewline -->
mold or repaired mold to provide a smooth surface which, when 
<!-- PJG 0012 frnewline -->
coated with a mold release coating, prevents products from sticking 
<!-- PJG 0012 frnewline -->
to the mold. 
<!-- PJG 0012 frnewline -->

<!-- PJG 0012 frnewline -->

<!-- PJG /ITAG -->

<!-- PJG ITAG l=11 g=1 f=3 -->
Multi-colored coating 
<!-- PJG /ITAG -->

<!-- PJG ITAG l=11 g=1 f=1 -->
means a coating which exhibits more than 
<!-- PJG 0012 frnewline -->
one color when applied, and which is packaged in a single container 
<!-- PJG 0012 frnewline -->
and applied in a single coat. 
<!-- PJG 0012 frnewline -->

<!-- PJG 0012 frnewline -->

<!-- PJG /ITAG -->

<!-- PJG ITAG l=11 g=1 f=3 -->
Pigmented coatings 
<!-- PJG /ITAG -->

<!-- PJG ITAG l=11 g=1 f=1 -->
means opaque coatings which contain binders 
<!-- PJG 0012 frnewline -->
and colored pigments which are formulated to hide the wood surface, 
<!-- PJG 0012 frnewline -->
either as an undercoat or topcoat. 
<!-- PJG 0012 frnewline -->

<!-- PJG 0012 frnewline -->

<!-- PJG /ITAG -->

<!-- PJG ITAG l=11 g=1 f=3 -->
Rate per calendar year 
<!-- PJG /ITAG -->

<!-- PJG ITAG l=11 g=1 f=1 -->
means the amount applied between 12 
<!-- PJG 0012 frnewline -->
a.m. January 1 and 11:59 p.m. December 31. 
<!-- PJG 0012 frnewline -->

<!-- PJG 0012 frnewline -->

<!-- PJG /ITAG -->

<!-- PJG ITAG l=11 g=1 f=3 -->
Rate per day 
<!-- PJG /ITAG -->

<!-- PJG ITAG l=11 g=1 f=1 -->
means the amount applied between 12 a.m. and 
<!-- PJG 0012 frnewline -->
11:59 p.m. on the same calendar day. 
<!-- PJG 0012 frnewline -->

<!-- PJG 0012 frnewline -->

<!-- PJG /ITAG -->

<!-- PJG ITAG l=11 g=1 f=3 -->
Repair coating 
<!-- PJG /ITAG -->

<!-- PJG ITAG l=11 g=1 f=1 -->
means a coating used to recoat portions of a 
<!-- PJG 0012 frnewline -->
product which has sustained mechanical damage to the coating 
<!-- PJG 0012 frnewline -->
following normal painting operations. 
<!-- PJG 0012 frnewline -->

<!-- PJG 0012 frnewline -->

<!-- PJG /ITAG -->

<!-- PJG ITAG l=11 g=1 f=3 -->
Roll coater 
<!-- PJG /ITAG -->

<!-- PJG ITAG l=11 g=1 f=1 -->
means a series of mechanical rollers that forms a 
<!-- PJG 0012 frnewline -->
thin coating film on the surface of the roller, which is applied to 
<!-- PJG 0012 frnewline -->
a substrate by moving the substrate underneath the roller. 
<!-- PJG 0012 frnewline -->

<!-- PJG 0012 frnewline -->

<!-- PJG /ITAG -->

<!-- PJG ITAG l=11 g=1 f=3 -->
Sealer 
<!-- PJG /ITAG -->

<!-- PJG ITAG l=11 g=1 f=1 -->
means a coating, containing binders, which seals the 
<!-- PJG 0012 frnewline -->
wood prior to application of the subsequent coatings. 
<!-- PJG 0012 frnewline -->

<!-- PJG 0012 frnewline -->

<!-- PJG /ITAG -->

<!-- PJG ITAG l=11 g=1 f=3 -->
Simulated wood materials 
<!-- PJG /ITAG -->

<!-- PJG ITAG l=11 g=1 f=1 -->
means materials, such as plastic, 
<!-- PJG 0012 frnewline -->
glass, metal, etc., that are made to give a wood-like appearance or 
<!-- PJG 0012 frnewline -->
are processed like a wood product. 
<!-- PJG 0012 frnewline -->

<!-- PJG 0012 frnewline -->

<!-- PJG /ITAG -->

<!-- PJG ITAG l=11 g=1 f=3 -->
Stencil coating 
<!-- PJG /ITAG -->

<!-- PJG ITAG l=11 g=1 f=1 -->
means an ink or a pigmented coating which is 
<!-- PJG 0012 frnewline -->
rolled or brushed onto a template or stamp in order to add 
<!-- PJG 0012 frnewline -->
identifying letters and/or numbers to wood products. 
<!-- PJG 0012 frnewline -->

<!-- PJG 0012 frnewline -->

<!-- PJG /ITAG -->

<!-- PJG ITAG l=11 g=1 f=3 -->
Stripper 
<!-- PJG /ITAG -->

<!-- PJG ITAG l=11 g=1 f=1 -->
means a liquid used to remove cured coatings, cured 
<!-- PJG 0012 frnewline -->
inks, and/or cured adhesives. 
<!-- PJG 0012 frnewline -->

<!-- PJG 0012 frnewline -->

<!-- PJG /ITAG -->

<!-- PJG ITAG l=11 g=1 f=3 -->
Toner 
<!-- PJG /ITAG -->

<!-- PJG ITAG l=11 g=1 f=1 -->
means a wash coat which contains binders and dyes or 
<!-- PJG 0012 frnewline -->
pigments to add tint to a coated surface. 
<!-- PJG 0012 frnewline -->

<!-- PJG 0012 frnewline -->

<!-- PJG /ITAG -->

<!-- PJG ITAG l=11 g=1 f=3 -->
Touch-up coating 
<!-- PJG /ITAG -->

<!-- PJG ITAG l=11 g=1 f=1 -->
means a coating used to cover minor coating 
<!-- PJG 0012 frnewline -->
imperfections appearing after the main coating operation. 
<!-- PJG 0012 frnewline -->

<!-- PJG 0012 frnewline -->

<!-- PJG /ITAG -->

<!-- PJG ITAG l=11 g=1 f=3 -->
Wash coat 
<!-- PJG /ITAG -->

<!-- PJG ITAG l=11 g=1 f=1 -->
means a coating that contains no more than 1.0 pound 
<!-- PJG 0012 frnewline -->
of solids per gallon, by weight, which is used to seal wood 
<!-- PJG 0012 frnewline -->
surfaces, prevent undesired staining, and control penetration. 
<!-- PJG 0012 frnewline -->

<!-- PJG 0012 frnewline -->

<!-- PJG /ITAG -->

<!-- PJG ITAG l=11 g=1 f=3 -->
Wood product coating application operations 
<!-- PJG /ITAG -->

<!-- PJG ITAG l=11 g=1 f=1 -->
means a 
<!-- PJG 0012 frnewline -->
combination of coating application steps which may include use of 
<!-- PJG 0012 frnewline -->
spray guns, flash-off areas, spray booths, ovens, conveyors, and/or 
<!-- PJG 0012 frnewline -->
other equipment operated for the purpose of applying coating 
<!-- PJG 0012 frnewline -->
materials. 
<!-- PJG 0012 frnewline -->

<!-- PJG 0012 frnewline -->

<!-- PJG /ITAG -->

<!-- PJG ITAG l=11 g=1 f=3 -->
Wood products 
<!-- PJG /ITAG -->

<!-- PJG ITAG l=11 g=1 f=1 -->
means those surface-coated room furnishings 
<!-- PJG 0012 frnewline -->
which include cabinets (kitchen, bath, and vanity), tables, chairs, 
<!-- PJG 0012 frnewline -->
beds, sofas, shutters, art objects, and any other coated objects 
<!-- PJG 0012 frnewline -->
made of solid wood, and/or wood composition, and/or made of 
<!-- PJG 0012 frnewline -->
simulated wood material used in combination with solid wood or wood 
<!-- PJG 0012 frnewline -->
composition. 
<!-- PJG 0012 frnewline -->

<!-- PJG 0012 frnewline -->
(3) 
<!-- PJG /ITAG -->

<!-- PJG ITAG l=11 g=1 f=3 -->
Standards. 
<!-- PJG 0012 frnewline -->

<!-- PJG 0012 frnewline -->
(i) VOC Content of Coatings and Strippers. 
<!-- PJG 0012 frnewline -->

<!-- PJG 0012 frnewline -->
(A) A person or facility shall not apply any coating to 
<!-- PJG 0012 frnewline -->
a wood product which has a VOC content, including any 
<!-- PJG 0012 frnewline -->
VOC-containing material added to the original coating supplied 
<!-- PJG 0012 frnewline -->
by the manufacturer, which exceeds the applicable limit 
<!-- PJG 0012 frnewline -->
specified below: 
<!-- PJG 0012 frnewline -->

<!-- PJG 0012 frnewline -->

<!-- PJG /ITAG -->

<!-- PJG /STAG -->
</TEXT>
</DOC>



