<!-- PJG /ITAG -->

</FOOTNAME>
<!-- PJG ITAG l=28 g=1 f=1 -->
See Volume IV, Chapter 5 of EPA's 
<!-- PJG /ITAG -->

<!-- PJG ITAG l=28 g=1 f=3 -->
Procedures for Emission Inventory Preparation.
<!-- PJG /ITAG -->

<!-- PJG QTAG 02 -->
<!-- PJG /QTAG -->
 
<!-- PJG 0012 frnewline -->
</FOOTNOTE>

