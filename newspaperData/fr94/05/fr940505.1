) Brand name and model; 
<!-- PJG 0012 frnewline -->

<!-- PJG 0012 frnewline -->
(
<!-- PJG /ITAG -->

<!-- PJG ITAG l=11 g=1 f=3 -->
3
<!-- PJG /ITAG -->

<!-- PJG ITAG l=11 g=1 f=1 -->
) Model number as it appears on the rating plate of each 
<!-- PJG 0012 frnewline -->
water heater; and 
<!-- PJG 0012 frnewline -->

<!-- PJG 0012 frnewline -->
(
<!-- PJG /ITAG -->

<!-- PJG ITAG l=11 g=1 f=3 -->
4
<!-- PJG /ITAG -->

<!-- PJG ITAG l=11 g=1 f=1 -->
) Description of each water heater model being certified. 
<!-- PJG 0012 frnewline -->

<!-- PJG 0012 frnewline -->
(B) 
<!-- PJG /ITAG -->

<!-- PJG ITAG l=11 g=1 f=3 -->
Test Report
<!-- PJG /ITAG -->

<!-- PJG ITAG l=11 g=1 f=1 -->
. 
<!-- PJG 0012 frnewline -->

<!-- PJG 0012 frnewline -->
(
<!-- PJG /ITAG -->

<!-- PJG ITAG l=11 g=1 f=3 -->
1
<!-- PJG /ITAG -->

<!-- PJG ITAG l=11 g=1 f=1 -->
) All compliance test procedures and results for each 
<!-- PJG 0012 frnewline -->
water heater model; and 
<!-- PJG 0012 frnewline -->

<!-- PJG 0012 frnewline -->

<!-- PJG /ITAG -->

<!-- PJG /STAG -->
</TEXT>
