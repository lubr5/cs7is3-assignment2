<!-- PJG 0012 frnewline -->
following detection of the leak, as specified in the table 
<!-- PJG 0012 frnewline -->
of repair periods in paragraph (t) of this section. 
<!-- PJG 0012 frnewline -->
(
<!-- PJG /ITAG -->

<!-- PJG ITAG l=11 g=1 f=3 -->
3
