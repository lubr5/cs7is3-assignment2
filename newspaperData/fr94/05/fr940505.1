<!-- PJG STAG 4702 -->

<!-- PJG 0012 frnewline -->

<!-- PJG 0012 frnewline -->

<!-- PJG ITAG l=11 g=1 f=1 -->

<!-- PJG /ITAG -->

<!-- PJG ITAG l=11 g=1 f=3 -->
Motorcycle 
<!-- PJG /ITAG -->

<!-- PJG ITAG l=11 g=1 f=1 -->
means any motor vehicle other than a tractor having 
<!-- PJG 0012 frnewline -->
a seat or saddle for the use of the rider, which is designed to 
<!-- PJG 0012 frnewline -->
travel on not more than three wheels in contact with the ground and 
<!-- PJG 0012 frnewline -->
weighs less than 1,500 pounds. Four wheels may be in contact with 
<!-- PJG 0012 frnewline -->
the ground when two of the wheels are a functional part of a 
<!-- PJG 0012 frnewline -->
sidecar. 
<!-- PJG 0012 frnewline -->

<!-- PJG /ITAG -->

<!-- PJG ITAG l=11 g=1 f=3 -->
Multistage topcoat system 
<!-- PJG /ITAG -->

<!-- PJG ITAG l=11 g=1 f=1 -->
means any basecoat/clearcoat topcoat 
<!-- PJG 0012 frnewline -->
system or any three-stage topcoat system, manufactured as a system, 
<!-- PJG 0012 frnewline -->
and used as specified by the manufacturer. 
<!-- PJG 0012 frnewline -->

<!-- PJG /ITAG -->

<!-- PJG ITAG l=11 g=1 f=3 -->
Passenger car 
<!-- PJG /ITAG -->

<!-- PJG ITAG l=11 g=1 f=1 -->
means any motor vehicle designed primarily for 
<!-- PJG 0012 frnewline -->
transportation of persons and having a design capacity of 12 
<!-- PJG 0012 frnewline -->
persons or less. 
<!-- PJG 0012 frnewline -->

<!-- PJG /ITAG -->

<!-- PJG ITAG l=11 g=1 f=3 -->
Polyurethane enamel 
<!-- PJG /ITAG -->

<!-- PJG ITAG l=11 g=1 f=1 -->
means an enamel coating derived from a 
<!-- PJG 0012 frnewline -->
thermosetting polymer produced by the condensation reaction of a 
<!-- PJG 0012 frnewline -->
polyisocyanate and an hydroxyl-containing material. 
<!-- PJG 0012 frnewline -->

<!-- PJG /ITAG -->

<!-- PJG ITAG l=11 g=1 f=3 -->
Precoat coating 
<!-- PJG /ITAG -->

<!-- PJG ITAG l=11 g=1 f=1 -->
means a coating applied to bare metal 
<!-- PJG 0012 frnewline -->
primarily to deactivate the metal surface for corrosion resistance 
<!-- PJG 0012 frnewline -->
to a subsequent water-base primer. 
<!-- PJG 0012 frnewline -->

<!-- PJG /ITAG -->

<!-- PJG ITAG l=11 g=1 f=3 -->
Pretreatment coating 
<!-- PJG /ITAG -->

<!-- PJG ITAG l=11 g=1 f=1 -->
means a coating which contains no more 
<!-- PJG 0012 frnewline -->
than 12 percent solids, by weight, and at least 1/2-percent acid, 
<!-- PJG 0012 frnewline -->
by weight, which is used to provide surface etching and is applied 
<!-- PJG 0012 frnewline -->
directly to bare metal surfaces to provide corrosion resistance and 
<!-- PJG 0012 frnewline -->
adhesion. 
<!-- PJG 0012 frnewline -->

<!-- PJG /ITAG -->

<!-- PJG ITAG l=11 g=1 f=3 -->
Primer 
<!-- PJG /ITAG -->

<!-- PJG ITAG l=11 g=1 f=1 -->
means a coating applied for purposes of corrosion 
<!-- PJG 0012 frnewline -->
resistance or adhesion of subsequent coatings. 
<!-- PJG 0012 frnewline -->

<!-- PJG /ITAG -->

<!-- PJG ITAG l=11 g=1 f=3 -->
Primer sealer 
<!-- PJG /ITAG -->

<!-- PJG ITAG l=11 g=1 f=1 -->
means a coating applied prior to the application 
<!-- PJG 0012 frnewline -->
of a topcoat for the purpose of color uniformity, or to promote the 
<!-- PJG 0012 frnewline -->
ability of an underlying coating to resist penetration by the 
<!-- PJG 0012 frnewline -->
topcoat. 
<!-- PJG 0012 frnewline -->

<!-- PJG /ITAG -->

<!-- PJG ITAG l=11 g=1 f=3 -->
Primer surfacer 
<!-- PJG /ITAG -->

<!-- PJG ITAG l=11 g=1 f=1 -->
means a coating applied for the purpose of 
<!-- PJG 0012 frnewline -->
corrosion resistance or adhesion, and which promotes a uniform 
<!-- PJG 0012 frnewline -->
surface by filling in surface imperfections. 
<!-- PJG 0012 frnewline -->

<!-- PJG /ITAG -->

<!-- PJG ITAG l=11 g=1 f=3 -->
Rocker panel 
<!-- PJG /ITAG -->

<!-- PJG ITAG l=11 g=1 f=1 -->
means the panel area of a motor vehicle which is 
<!-- PJG 0012 frnewline -->
no more than 10 inches from the bottom of a door, quarter panel, or 
<!-- PJG 0012 frnewline -->
fender. 
<!-- PJG 0012 frnewline -->

<!-- PJG /ITAG -->

<!-- PJG ITAG l=11 g=1 f=3 -->
Rubberized asphaltic underbody coating 
<!-- PJG /ITAG -->

<!-- PJG ITAG l=11 g=1 f=1 -->
means a coating applied 
<!-- PJG 0012 frnewline -->
to wheel wells, the inside of door panels or fenders, the underside 
<!-- PJG 0012 frnewline -->
of a trunk or hood, or the underside of the motor vehicle itself 
<!-- PJG 0012 frnewline -->
for the purpose of sound deadening or protection. 
<!-- PJG 0012 frnewline -->

<!-- PJG /ITAG -->

<!-- PJG ITAG l=11 g=1 f=3 -->
Specialty coating 
<!-- PJG /ITAG -->

<!-- PJG ITAG l=11 g=1 f=1 -->
means any of the following coatings: 
<!-- PJG 0012 frnewline -->
adhesion promoters, uniform finish blenders, elastomeric materials, 
<!-- PJG 0012 frnewline -->
anti-glare safety coatings, impact-resistant coatings, rubberized 
<!-- PJG 0012 frnewline -->
asphaltic underbody coatings, water hold-out coatings, weld-thru 
<!-- PJG 0012 frnewline -->
coatings, and bright metal trim repair coatings. 
<!-- PJG 0012 frnewline -->

<!-- PJG /ITAG -->

<!-- PJG ITAG l=11 g=1 f=3 -->
Spot repairs 
<!-- PJG /ITAG -->

<!-- PJG ITAG l=11 g=1 f=1 -->
mean repairs to motor vehicles in which the 
<!-- PJG 0012 frnewline -->
damaged area to be repaired is limited to only a portion of any 
<!-- PJG 0012 frnewline -->
given panel so that an entire panel need not be repaired. 
<!-- PJG 0012 frnewline -->

<!-- PJG /ITAG -->

<!-- PJG ITAG l=11 g=1 f=3 -->
Stencil coating 
<!-- PJG /ITAG -->

<!-- PJG ITAG l=11 g=1 f=1 -->
means an ink or a pigmented coating which is 
<!-- PJG 0012 frnewline -->
rolled or brushed onto a template or a stamp in order to add 
<!-- PJG 0012 frnewline -->
identifying letters, symbols, and/or numbers to motor vehicles, 
<!-- PJG 0012 frnewline -->
mobile equipment, or their parts and components. 
<!-- PJG 0012 frnewline -->

<!-- PJG /ITAG -->

<!-- PJG ITAG l=11 g=1 f=3 -->
Three-stage topcoat system 
<!-- PJG /ITAG -->

<!-- PJG ITAG l=11 g=1 f=1 -->
means a topcoat system composed of 
<!-- PJG 0012 frnewline -->
a basecoat portion, a midcoat portion and a transparent clearcoat 
<!-- PJG 0012 frnewline -->
portion. The VOC content of a three-stage topcoat system shall be 
<!-- PJG 0012 frnewline -->
calculated according to the following formula: 
<!-- PJG 0012 frnewline -->

<!-- PJG 0012 frnewline -->

<!-- PJG /ITAG -->

<!-- PJG /STAG -->

<!-- PJG STAG 4725 -->

<IMPORT>

<!-- PJG importformat s,w160,d26 -->

<!-- PJG 0012 frnewline -->

<!-- PJG ITAG l=92 g=1 f=1 -->
E:GRAPHICSEP05MY94.099
<!-- PJG 0012 frnewline -->

<!-- PJG /ITAG -->

</IMPORT>

<!-- PJG /STAG -->

