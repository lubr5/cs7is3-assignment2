<!-- PJG 0012 frnewline -->

<!-- PJG 0012 frnewline -->

<!-- PJG ITAG l=16 g=1 f=1 -->
Where: 
<!-- PJG 0012 frnewline -->
VOCms=the composite VOC content, less water and less 
<!-- PJG 0012 frnewline -->
exempt compounds to be used for compliance 
<!-- PJG 0012 frnewline -->
determination under the multistage topcoat 
<!-- PJG 0012 frnewline -->
system coating category. 
<!-- PJG 0012 frnewline -->
VOCbc=the VOC content, less water and less exempt 
<!-- PJG 0012 frnewline -->
compounds as applied, of any given basecoat. 
<!-- PJG 0012 frnewline -->
VOVmc=the VOC content, less water and less exempt 
<!-- PJG 0012 frnewline -->
compounds as applied, of any given midcoat. 
<!-- PJG 0012 frnewline -->
2 VOCcc=two times the VOC content, less water and less 
<!-- PJG 0012 frnewline -->
exempt compounds as applied, of any given 
<!-- PJG 0012 frnewline -->
clearcoat. 
<!-- PJG 0012 frnewline -->

<!-- PJG /ITAG -->

<!-- PJG ITAG l=11 g=1 f=1 -->

<!-- PJG /ITAG -->

<!-- PJG ITAG l=11 g=1 f=3 -->
Topcoat 
<!-- PJG /ITAG -->

<!-- PJG ITAG l=11 g=1 f=1 -->
means a coating applied over any coating, for the 
<!-- PJG 0012 frnewline -->
purpose of appearance, identification, or protection. 
<!-- PJG 0012 frnewline -->

<!-- PJG /ITAG -->

<!-- PJG ITAG l=11 g=1 f=3 -->
Touch-up coating 
<!-- PJG /ITAG -->

<!-- PJG ITAG l=11 g=1 f=1 -->
means a coating applied by brush or 
<!-- PJG 0012 frnewline -->
non-refillable aerosol can to cover minor surface damage and 
<!-- PJG 0012 frnewline -->
dispensed in containers of no more than 8 ounces. 
<!-- PJG 0012 frnewline -->

<!-- PJG /ITAG -->

<!-- PJG ITAG l=11 g=1 f=3 -->
Truck 
<!-- PJG /ITAG -->

<!-- PJG ITAG l=11 g=1 f=1 -->
means a motor vehicle designed, used, or maintained 
<!-- PJG 0012 frnewline -->
primarily for the transportation of property. 
<!-- PJG 0012 frnewline -->
(1) 
<!-- PJG /ITAG -->

<!-- PJG ITAG l=11 g=1 f=3 -->
Large-sized truck 
<!-- PJG /ITAG -->

<!-- PJG ITAG l=11 g=1 f=1 -->
means a truck having a 
<!-- PJG 0012 frnewline -->
manufacturer's gross vehicle weight rating of more than 8,600 
<!-- PJG 0012 frnewline -->
pounds. 
<!-- PJG 0012 frnewline -->
(2) 
<!-- PJG /ITAG -->

<!-- PJG ITAG l=11 g=1 f=3 -->
Medium-sized truck 
<!-- PJG /ITAG -->

<!-- PJG ITAG l=11 g=1 f=1 -->
means a truck having a 
<!-- PJG 0012 frnewline -->
manufacturer's gross vehicle weight of 6,001 to 8,600 pounds. 
<!-- PJG 0012 frnewline -->
(3) 
<!-- PJG /ITAG -->

<!-- PJG ITAG l=11 g=1 f=3 -->
Small-sized truck 
<!-- PJG /ITAG -->

<!-- PJG ITAG l=11 g=1 f=1 -->
means any motor vehicle having a 
<!-- PJG 0012 frnewline -->
manufacturer's gross vehicle weight rating at 6,000 pounds or 
<!-- PJG 0012 frnewline -->
less and which is designed primarily for the purposes of 
<!-- PJG 0012 frnewline -->
transportation of property or is a derivative of such vehicle, 
<!-- PJG 0012 frnewline -->
or is available with special features enabling on-street or 
<!-- PJG 0012 frnewline -->
off-highway operation and use. 
<!-- PJG 0012 frnewline -->

<!-- PJG /ITAG -->

<!-- PJG ITAG l=11 g=1 f=3 -->
Uniform finish blenders 
<!-- PJG /ITAG -->

<!-- PJG ITAG l=11 g=1 f=1 -->
mean coatings which are applied in 
<!-- PJG 0012 frnewline -->
spot repairs for the purpose of blending a paint overspray area of 
<!-- PJG 0012 frnewline -->
a repaired topcoat to match the appearance of an adjacent existing 
<!-- PJG 0012 frnewline -->
topcoat. 
<!-- PJG 0012 frnewline -->

<!-- PJG /ITAG -->

<!-- PJG ITAG l=11 g=1 f=3 -->
Van 
<!-- PJG /ITAG -->

<!-- PJG ITAG l=11 g=1 f=1 -->
means a closed truck for carrying property or persons. 
<!-- PJG 0012 frnewline -->
(1) 
<!-- PJG /ITAG -->

<!-- PJG ITAG l=11 g=1 f=3 -->
Medium-sized van 
<!-- PJG /ITAG -->

<!-- PJG ITAG l=11 g=1 f=1 -->
means a van having a manufacturer's 
<!-- PJG 0012 frnewline -->
gross vehicle weight rating of 6,001 to 8,600 pounds. 
<!-- PJG 0012 frnewline -->
(2) 
<!-- PJG /ITAG -->

<!-- PJG ITAG l=11 g=1 f=3 -->
Small-sized van 
<!-- PJG /ITAG -->

<!-- PJG ITAG l=11 g=1 f=1 -->
means a van having a manufacturer's 
<!-- PJG 0012 frnewline -->
gross vehicle weight rating at 6,000 pounds or less and which 
<!-- PJG 0012 frnewline -->
is designed primarily for purposes of transportation of 
<!-- PJG 0012 frnewline -->
property and/or persons. 
<!-- PJG 0012 frnewline -->

<!-- PJG /ITAG -->

<!-- PJG ITAG l=11 g=1 f=3 -->
Vehicle 
<!-- PJG /ITAG -->

<!-- PJG ITAG l=11 g=1 f=1 -->
means a device by which any person or property may be 
<!-- PJG 0012 frnewline -->
propelled, moved, or drawn upon a highway, excepting a device moved 
<!-- PJG 0012 frnewline -->
exclusively by human power or used exclusively upon stationary 
<!-- PJG 0012 frnewline -->
rails or tracks. 
<!-- PJG 0012 frnewline -->

<!-- PJG 0012 frnewline -->

<!-- PJG /ITAG -->

<!-- PJG /STAG -->
</TEXT>
