($10,000/ton)&times;(0.394 lbs/LTO) divided by 2,000 lbs/ton=$1.97/LTO for VOC 
<!-- PJG 0012 frnewline -->
($10,000/ton)&times;(0.065 lbs/LTO) divided by 2,000 lbs/ton=$0.325/LTO for NO
<!-- PJG /ITAG -->

<!-- PJG ITAG l=16 g=5 f=2 -->
