<!-- PJG 0012 frnewline -->

<!-- PJG 0012 frnewline -->

<!-- PJG /ITAG -->

<!-- PJG ITAG l=11 g=1 f=3 -->
Malt beverage production facility 
<!-- PJG /ITAG -->

<!-- PJG ITAG l=11 g=1 f=1 -->
means a facility engaged in malting, fermentation, aging, or packaging of barley or any other grain for the purpose
of producing an alcoholic beverage. 
<!-- PJG 0012 frnewline -->

<!-- PJG 0012 frnewline -->

<!-- PJG /ITAG -->

<!-- PJG ITAG l=11 g=1 f=3 -->
Vegetable oil production facility 
<!-- PJG /ITAG -->

<!-- PJG ITAG l=11 g=1 f=1 -->
